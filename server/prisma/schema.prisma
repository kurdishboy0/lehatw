generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Roles & Statuses
enum Role {
  STUDENT
  HR
  INSTRUCTOR
  ADMIN
}

// Instructors go through the same review as companies before they can teach.
enum InstructorStatus {
  PENDING
  APPROVED
  REJECTED
}

enum HRStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED // temporary; lifts automatically once suspendedUntil passes (or indefinite if null)
  BANNED
}

enum ReportTarget {
  USER
  MESSAGE
  JOB
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum CourseStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum CourseLanguage {
  ENGLISH
  ARABIC
  KURDISH
  MIXED
}

enum CourseDelivery {
  ONLINE
  IN_PERSON
  HYBRID
}

enum EventType {
  ACADEMIC
  COMPANY
  CAREER_FAIR
  WORKSHOP
  OTHER
}

enum AnnouncementType {
  INFO
  WARNING
  SUCCESS
}

// 2. Core User Table
model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  password   String? // Made optional for social logins!
  googleId   String?  @unique // For Google Login
  linkedinId String?  @unique // For LinkedIn Login
  role       Role     @default(STUDENT)
  createdAt  DateTime @default(now())

  // --- ACCOUNT STATUS (moderation) ---
  accountStatus  AccountStatus @default(ACTIVE)
  statusReason   String?
  suspendedUntil DateTime?
  // Only super-admins can create/remove admins or change anyone to/from ADMIN.
  isSuperAdmin   Boolean       @default(false)

  // --- FIELDS FOR OTP ---
  resetOtp        String? // Stores the 6-digit code
  resetOtpExpires DateTime? // Stores when the code expires (e.g., in 15 mins)

  // --- PHONE VERIFICATION ---
  phone           String?
  phoneVerified   Boolean   @default(false)
  phoneOtp        String?
  phoneOtpExpires DateTime?

  studentProfile    StudentProfile?
  hrProfile         HRProfile?
  instructorProfile InstructorProfile?

  // --- NEW: Link to Applications ---
  applications Application[] @relation("StudentApplications")

  sentMessages     Message[]      @relation("SentMessages")
  receivedMessages Message[]      @relation("ReceivedMessages")
  notifications    Notification[]

  setupTokens        AccountSetupToken[]
  courseEnrollments  CourseEnrollment[]
  eventsCreated      Event[]
  eventRegistrations EventRegistration[]
  reportsFiled       Report[]              @relation("ReportsFiled")
  reportsResolved    Report[]              @relation("ReportsResolved")
  adminActions       AdminAuditLog[]
  announcements      Announcement[]
  translationEdits   TranslationOverride[]
}

// 3. Student Profiles (Public)
// Someone who teaches courses on Lehatw.
model InstructorProfile {
  id          Int     @id @default(autoincrement())
  userId      Int     @unique
  user        User    @relation(fields: [userId], references: [id])
  fullName    String
  headline    String? // "Senior data engineer", "English teacher at ..."
  bio         String?
  expertise   String? // free text: what they teach
  website     String?
  linkedinUrl String?
  photoUrl    String?
  phone       String?

  status          InstructorStatus @default(PENDING)
  rejectionReason String? // shown to them so they know what to fix

  courses   Course[]
  createdAt DateTime @default(now())
}

// A course taught by an instructor. Admins review each one before students
// can see it, and can also create courses on an instructor's behalf.
model Course {
  id                  Int               @id @default(autoincrement())
  instructorProfileId Int
  instructor          InstructorProfile @relation(fields: [instructorProfileId], references: [id], onDelete: Cascade)
  title               String
  summary             String? // one or two lines for the course card
  description         String?
  level               CourseLevel       @default(ALL_LEVELS)
  language            CourseLanguage    @default(ENGLISH)
  delivery            CourseDelivery    @default(ONLINE)
  location            String? // for in-person and hybrid courses
  priceIqd            Int               @default(0) // 0 means free
  durationHours       Int?
  startsAt            DateTime? // for courses that run as a group; null means self-paced
  externalUrl         String? // the instructor's own page, if they have one
  coverImageUrl       String?

  status          CourseStatus @default(DRAFT)
  rejectionReason String? // shown to the instructor so they know what to fix
  publishedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  skills      CourseSkill[]
  lessons     CourseLesson[]
  enrollments CourseEnrollment[]

  @@index([status])
}

// What a course teaches, so it can be recommended for skills a student lacks.
model CourseSkill {
  id       Int    @id @default(autoincrement())
  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skillId  Int
  skill    Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([courseId, skillId])
}

model CourseLesson {
  id              Int     @id @default(autoincrement())
  courseId        Int
  course          Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  position        Int // order within the course
  title           String
  content         String? // the lesson text
  videoUrl        String?
  resourceUrl     String? // slides, exercises, anything to download
  durationMinutes Int?
  isPreview       Boolean @default(false) // readable before enrolling

  progress LessonProgress[]

  @@index([courseId, position])
}

model CourseEnrollment {
  id          Int       @id @default(autoincrement())
  courseId    Int
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  completedAt DateTime? // set when every lesson is done

  progress LessonProgress[]

  @@unique([courseId, userId])
}

model LessonProgress {
  id           Int              @id @default(autoincrement())
  enrollmentId Int
  enrollment   CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     Int
  lesson       CourseLesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt  DateTime         @default(now())

  @@unique([enrollmentId, lessonId])
}

model StudentProfile {
  id             Int     @id @default(autoincrement())
  userId         Int     @unique
  user           User    @relation(fields: [userId], references: [id])
  fullName       String
  university     String
  fieldOfStudy   String
  graduationYear Int?
  bio            String?
  photoUrl       String?
  resumeUrl      String? // Optional CV/resume on file; auto-attaches to job applications
  portfolioUrl   String?
  linkedinUrl    String?
  githubUrl      String?
  huggingFaceUrl String?

  // Privacy: other students see this student's email on "Peers like you"
  // only when they opt in. Companies can always see it on candidate lists.
  showEmailToStudents Boolean @default(false)

  skills         StudentSkill[]
  customSkills   CustomSkill[]
  jobInvitations JobInvitation[]
}

// 4. HR Profiles (Requires Admin Approval)
model HRProfile {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  // Fields matching your React form
  companyName String
  industry    String
  jobTitle    String
  crNumber    String

  // Made optional so they don't crash if omitted
  website String?
  phone   String?
  address String?
  taxId   String?

  status          HRStatus @default(PENDING)
  rejectionReason String? // shown to the company so they know what to fix

  jobPosts JobPost[] // Links HR to the jobs they post
}

// 5a. Broad Academic Subject Areas (e.g. Engineering & Technology, Health & Medical Sciences)
// Groups Fields of Study (Category) the way Kurdistan Region university faculties are organized.
model SubjectArea {
  id         Int        @id @default(autoincrement())
  name_en    String
  name_ar    String
  name_ckb   String
  categories Category[]
}

// 5. Multilingual Skill Categories (Fields of Study)
model Category {
  id            Int          @id @default(autoincrement())
  name_en       String
  name_ar       String
  name_ckb      String
  subjectAreaId Int?
  subjectArea   SubjectArea? @relation(fields: [subjectAreaId], references: [id])
  skills        Skill[]
}

// 6. Multilingual Master Skills List
model Skill {
  id         Int      @id @default(autoincrement())
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  name_en    String
  name_ar    String
  name_ckb   String

  students StudentSkill[]
  jobPosts JobPostSkill[] // Links Skills to Job Posts
  courses  CourseSkill[]
}

// 7. Mapping Students to Skills
model StudentSkill {
  id               Int            @id @default(autoincrement())
  studentProfileId Int
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  skillId          Int
  skill            Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  proficiency      String // e.g., "Beginner", "Intermediate", "Expert"
}

// 8. The "Other" Skills (Pending Admin Review)
model CustomSkill {
  id               Int            @id @default(autoincrement())
  studentProfileId Int
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  name             String
  isApproved       Boolean        @default(false)
  createdAt        DateTime       @default(now())
}

// --- PHASE 1 MATCHING ENGINE --- //

// 9. HR Job Posts (The Target for Matching)
// 9. HR Job Posts
model JobPost {
  id               Int       @id @default(autoincrement())
  hrProfileId      Int
  hrProfile        HRProfile @relation(fields: [hrProfileId], references: [id], onDelete: Cascade)
  title            String
  description      String? // Summary / about the role
  responsibilities String? // Key responsibilities, one per line
  requirements     String? // Requirements / qualifications, one per line
  benefits         String? // What we offer, one per line (optional)
  location         String?
  employmentType   String? // e.g. Full-Time, Part-Time, Internship, Contract
  workMode         String? // e.g. On-Site, Remote, Hybrid
  experienceLevel  String? // e.g. "1-3 years of experience"
  education        String? // e.g. "Bachelor's degree in Computer Science"
  requiresCv       Boolean   @default(true)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())

  // Set when an admin takes a post down; the owning HR can't re-activate it.
  removedByAdmin Boolean   @default(false)
  removedReason  String?
  removedAt      DateTime?

  skills       JobPostSkill[]
  applications Application[]
  invitations  JobInvitation[]
}

// A company inviting a matched student to apply. One per student per job.
model JobInvitation {
  id               Int            @id @default(autoincrement())
  jobPostId        Int
  jobPost          JobPost        @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  studentProfileId Int
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([jobPostId, studentProfileId])
}

// 10. Required Skills mapped to a Job Post
model JobPostSkill {
  id        Int     @id @default(autoincrement())
  jobPostId Int
  jobPost   JobPost @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  skillId   Int
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
}

// 11. Applications
model Application {
  id          Int      @id @default(autoincrement())
  jobPostId   Int
  jobPost     JobPost  @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  studentId   Int
  student     User     @relation("StudentApplications", fields: [studentId], references: [id], onDelete: Cascade)
  status      String   @default("PENDING")
  coverLetter String?
  cvUrl       String? // NEW: Store attached CV path/link
  createdAt   DateTime @default(now())

  @@unique([jobPostId, studentId])
}

// 12. Direct Messages (student-to-student, and any user-to-user contact)
model Message {
  id          Int      @id @default(autoincrement())
  senderId    Int
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId Int
  recipient   User     @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  content     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([senderId, recipientId])
  @@index([recipientId, senderId])
}

// 13. In-app Notifications (job applications, status changes, approvals, etc.)
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // e.g. "APPLICATION_RECEIVED", "APPLICATION_STATUS", "NEW_MESSAGE", "SKILL_APPROVED", "HR_APPROVED", "JOB_MATCH"
  title     String
  body      String?
  link      String? // relative client-side route to navigate to on click
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

// 14. User-submitted reports of users, messages, or job posts, for admin review
// One-time link that lets an admin-created account choose its own password.
// The raw token is only ever in the email; the database keeps its hash.
model AccountSetupToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Report {
  id             Int          @id @default(autoincrement())
  reporterId     Int
  reporter       User         @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType     ReportTarget
  targetId       Int
  // What was reported, captured at report time, so the evidence survives
  // even if the message/job is later deleted or edited.
  targetSnapshot String?
  reason         String
  details        String?
  status         ReportStatus @default(OPEN)
  resolvedById   Int?
  resolvedBy     User?        @relation("ReportsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNote String?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

// 15. Record of every admin action, for accountability across multiple admins
model AdminAuditLog {
  id         Int      @id @default(autoincrement())
  adminId    Int?
  admin      User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminEmail String // kept even if the admin account is later removed
  action     String // e.g. "USER_BANNED", "HR_REJECTED", "SKILL_MERGED"
  targetType String?
  targetId   Int?
  summary    String // human-readable one-liner
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([adminId])
}

// 16. Site-wide banner messages
// Academic and company events, managed by admins.
model Event {
  id              Int       @id @default(autoincrement())
  title_en        String
  title_ar        String?
  title_ckb       String?
  description_en  String?
  description_ar  String?
  description_ckb String?
  type            EventType @default(ACADEMIC)
  host            String? // university, company, or organiser name
  location        String? // venue; null for online-only events
  isOnline        Boolean   @default(false)
  onlineUrl       String? // meeting link, shown to people who registered
  startsAt        DateTime
  endsAt          DateTime?
  capacity        Int? // null means no limit
  registrationUrl String? // when registration happens on another site
  isPublished     Boolean   @default(true)
  createdById     Int?
  createdBy       User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())

  registrations EventRegistration[]

  @@index([startsAt])
}

model EventRegistration {
  id        Int      @id @default(autoincrement())
  eventId   Int
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
}

model Announcement {
  id          Int              @id @default(autoincrement())
  message_en  String
  message_ar  String?
  message_ckb String?
  type        AnnouncementType @default(INFO)
  isActive    Boolean          @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdById Int?
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
}

// 17. Admin edits to UI text; layered over the bundled translations at runtime
model TranslationOverride {
  id          Int      @id @default(autoincrement())
  lang        String // "en" | "ar" | "ckb"
  key         String // dotted i18n key, e.g. "home.title"
  value       String
  updatedById Int?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt

  @@unique([lang, key])
}
